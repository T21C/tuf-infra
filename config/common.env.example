NODE_ENV=production
MODE=production
OS=linux
TUF_SUPPRESS_CONSOLE_LOGGER=false

# Host database. DB_USER is the API / migrate / backup role (schema ALL).
# Never use root. CDN, health, and CDC override with their own users.
# Provision with: sudo /srv/tuf/infra/bin/tuf-provision-mysql-users
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__REQUIRED__
DB_STAGING_DATABASE=
DB_LOGGING_DATABASE=
DB_USER=__REQUIRED__
DB_PASSWORD=__REQUIRED__

# Shared paths
LOG_PATH=/srv/tuf/data/logs
CDN_TEMP_ROOT=/srv/tuf/data/cdn-temp
WORKSPACE_ROOT=/srv/tuf/data/cdn-temp/tuf-workspaces
SEVEN_ZIP_PATH=/usr/bin/7z

# Internal and public service URLs
DEV_URL=http://127.0.0.1:5173
PROD_API_URL=https://api.tuforums.com
STAGING_API_URL=https://api.staging.tuforums.com
LOCAL_CDN_URL=http://127.0.0.1:3001
CDN_URL=https://cdn.tuforums.com
CDN_PORT=3001
CDC_HEALTH_PORT=3990

# Logging and pool diagnostics
SLOW_QUERY_THRESHOLD_MS=1000
SLOW_ENDPOINT_THRESHOLD_MS=1000
LOGGER_POOL_ACQUIRE_HOOK=
POOL_SATURATION_MONITOR=true
POOL_SATURATION_CHECK_MS=5000
POOL_SATURATION_LOG_THROTTLE_MS=60000
POOL_SATURATION_MIN_CONSECUTIVE_CHECKS=3
POOL_SATURATION_MIN_FILL_RATIO=0.8
POOL_SATURATION_MIN_WAITERS=1
