CDN_PORT=13001
CDN_BIND_ADDRESS=127.0.0.1

# Same CPU clamps as production (canary shares the 4 OCPU host).
PACK_DOWNLOAD_MAX_CONCURRENT_JOBS=2
PACK_DOWNLOAD_PARALLELISM=4
CDN_7Z_THREADS=2

# Sentry (node-cdn). Empty DSN disables the SDK.
SENTRY_DSN=
SENTRY_ENVIRONMENT=canary
SENTRY_SERVER_NAME=cdn
SENTRY_TRACES_FAST_SAMPLE_RATE=0.05

