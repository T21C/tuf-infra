# These values must differ from production before canary starts.
DB_DATABASE=__REQUIRED__
DB_STAGING_DATABASE=__REQUIRED__

# Keep all canary writes outside the production data root.
LOG_PATH=/srv/tuf-canary/data/logs
CDN_TEMP_ROOT=/srv/tuf-canary/data/cdn-temp
WORKSPACE_ROOT=/srv/tuf-canary/data/cdn-temp/tuf-workspaces

PROD_API_URL=http://127.0.0.1:13000
LOCAL_CDN_URL=http://127.0.0.1:13001
CDN_PORT=13001
CDC_HEALTH_PORT=13990
