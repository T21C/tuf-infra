PROD_PORT=13000
PORT=13000
BIND_ADDRESS=127.0.0.1
PROD_CLIENT_URL=http://127.0.0.1:18080
CLIENT_URL=http://127.0.0.1:18080
CORS_EXTRA_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
FRONTEND_URL=http://127.0.0.1:18080
FRONTEND_MANIFEST_URL=http://127.0.0.1:18080/.vite/manifest.json
TRANSLATIONS_BASE_URL=http://127.0.0.1:18080/translations
TRANSLATIONS_PATH=
COOKIE_SECURE=false
CACHE_PATH=/srv/tuf/data/cache
THUMBNAILS_CACHE_PATH=/srv/tuf/data/thumbnails
THUMBNAIL_RENDER_MODE=local
THUMBNAIL_REQUEST_WAIT_MS=5000
THUMBNAIL_OG_REQUEST_WAIT_MS=15000
THUMBNAIL_GENERATION_WAIT_MS=600000
MYSQL_BACKUP_PATH=/srv/tuf/data/backups/mysql
MYSQL_BACKUP_TEMP_PATH=/srv/tuf/data/backups/tmp
FILES_BACKUP_PATH=/srv/tuf/data/backups/files
ROOT_PATH=/app
ELASTICSEARCH_CA_PATH=/run/secrets/elasticsearch-ca.crt
ELASTICSEARCH_INDEX_PREFIX=tuf_canary_
INIT_DB=false
UPDATE_DB=false
LOAD_PFPS=false
# OAUTH_JWT_SECRET is required on the API (distinct from JWT_SECRET).
# Canary inherits it from production api.env via tuf-init-canary merge.
CDC_PROJECTORS_DISABLED=1
ES_RECONCILE_CRON_DISABLED=1
LEADERBOARD_RANK_SNAPSHOT_CRON_DISABLED=1
WEEKLY_CURATION_SCHEDULE_CRON_DISABLED=1
# Off while Google verifies youtube.readonly. Set true after approval.
YOUTUBE_CHANNEL_LINKING_ENABLED=false

# Community tag voting (Wilson lower bound). Threshold changes require rematerialize then reindex.
COMMUNITY_TAG_WILSON_Z=1.96
COMMUNITY_TAG_SCORE_ON=0.45
COMMUNITY_TAG_SCORE_OFF=0.35
COMMUNITY_TAG_CARD_CAP=7
COMMUNITY_TAG_CLEARER_WEIGHT=10
COMMUNITY_TAG_DEFAULT_WEIGHT=1
DISCORD_ANNOUNCEMENT_DELIVERY_FORCE=false
DISCORD_ANNOUNCEMENT_WEBHOOK_OVERRIDE=
RERATE_ANNOUNCEMENT_HOOK=
LEVEL_SUBMISSION_HOOK=
PASS_SUBMISSION_HOOK=
LEVEL_FILE_UPDATE_HOOK=
# Zen Mode media-report webhook (optional; reports return 503 if unset)
RATING_ZEN_REPORT_WEBHOOK_URL=
# Public mod catalog reports (inherits production via tuf-init-canary merge unless set here)
MOD_REPORT_WEBHOOK_URL=
# Official raters who reach 100 ratings in a UTC month (TUFStellar nominee notice)
TUFSTELLAR_NOMINEES_WEBHOOK_URL=

# Sentry (node-api). Empty DSN disables the SDK.
# Web Push inherits production VAPID keys via tuf-init-canary merge unless overridden.
# PUSH_NOTIFICATIONS_ENABLED=false
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@tuforums.com

SENTRY_DSN=
SENTRY_ENVIRONMENT=canary
SENTRY_SERVER_NAME=api
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_TRACES_FAST_SAMPLE_RATE=0.05
