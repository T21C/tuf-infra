THUMBNAIL_QUEUE_NAME=tuf-canary-thumbnail-render-v1
THUMBNAIL_QUEUE_PREFIX=tuf-canary
THUMBNAIL_WORKER_BIND_ADDRESS=127.0.0.1
THUMBNAIL_WORKER_PORT=13891
THUMBNAIL_WORKER_CONCURRENCY=1
THUMBNAIL_JOB_ATTEMPTS=2
THUMBNAIL_JOB_MAX_HTML_BYTES=16777216
THUMBNAIL_JOB_MAX_DIMENSION=4096
THUMBNAIL_QUEUE_MAX_WAITING=20
THUMBNAIL_REQUEST_WAIT_MS=5000
THUMBNAIL_OG_REQUEST_WAIT_MS=15000
THUMBNAIL_GENERATION_WAIT_MS=600000
THUMBNAIL_JOB_LOCK_MS=180000
THUMBNAIL_OUTPUT_POLL_MS=100
THUMBNAIL_JOB_INPUT_PATH=/srv/tuf/data/cache/thumbnail-render-inputs
THUMBNAILS_CACHE_PATH=/srv/tuf/data/thumbnails
HOME=/tmp
XDG_CONFIG_HOME=/tmp/.chromium
XDG_CACHE_HOME=/tmp/.chromium
