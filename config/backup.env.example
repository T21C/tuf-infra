# mysqldump / mysql restore role used only by the API BackupService.
# Loaded solely by the api Compose service (not CDN, health, CDC, or migrate).
# Needs SET_USER_ID + SYSTEM_USER to apply dumps whose DEFINER is root/backend.
# Not MySQL root. Provision with: sudo /srv/tuf/infra/bin/tuf-provision-mysql-users
BACKUP_DB_USER=__REQUIRED__
BACKUP_DB_PASSWORD=__REQUIRED__
