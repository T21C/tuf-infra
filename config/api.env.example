# API listener and public URLs
PROD_PORT=3000
PORT=3000
STAGING_PORT=3002
BIND_ADDRESS=127.0.0.1
PROD_CLIENT_URL=https://tuforums.com
STAGING_CLIENT_URL=https://staging.tuforums.com
CLIENT_URL=https://tuforums.com
FRONTEND_URL=https://tuforums.com
CORS_EXTRA_ORIGINS=
TRUST_PROXY=true
COOKIE_SECURE=true

# Frontend assets exposed by the frontend container
FRONTEND_MANIFEST_URL=http://127.0.0.1:8080/.vite/manifest.json
TRANSLATIONS_BASE_URL=http://127.0.0.1:8080/translations

# Persistent paths
CACHE_PATH=/srv/tuf/data/cache
THUMBNAILS_CACHE_PATH=/srv/tuf/data/thumbnails
MYSQL_BACKUP_PATH=/srv/tuf/data/backups/mysql
# Scratch for mysqldump before R2 upload (disk-backed; do not use /tmp — Compose tmpfs is tiny)
MYSQL_BACKUP_TEMP_PATH=/srv/tuf/data/backups/tmp
FILES_BACKUP_PATH=/srv/tuf/data/backups/files
ROOT_PATH=/app
MYSQL_PATH=
YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_COOKIES=

# Chromium/Puppeteer under a read-only rootfs (compose mounts writable tmpfs on /tmp).
# Without these, chrome_crashpad_handler fails with "--database is required".
HOME=/tmp
XDG_CONFIG_HOME=/tmp/.chromium
XDG_CACHE_HOME=/tmp/.chromium

# Safe rollout switch. Keep local until thumbnail-worker is healthy, then set queue.
THUMBNAIL_RENDER_MODE=local
THUMBNAIL_REQUEST_WAIT_MS=5000
THUMBNAIL_OG_REQUEST_WAIT_MS=15000
THUMBNAIL_GENERATION_WAIT_MS=600000

# Database startup behavior
INIT_DB=false
UPDATE_DB=false
LOAD_PFPS=false

# Authentication and application secrets
JWT_SECRET=__REQUIRED__
# OAuth AS access/refresh JWTs — must be set and distinct from JWT_SECRET
OAUTH_JWT_SECRET=__REQUIRED__
SUPER_ADMIN_KEY=__REQUIRED__
DISCORD_BOT_TOKEN=__REQUIRED__
DISCORD_CLIENT_ID=__REQUIRED__
DISCORD_CLIENT_SECRET=__REQUIRED__
DISCORD_REDIRECT_URI=https://api.tuforums.com/v2/auth/discord/callback
GOOGLE_CLIENT_ID=__REQUIRED__
GOOGLE_CLIENT_SECRET=__REQUIRED__
GOOGLE_CLOUD_PROJECT_ID=__REQUIRED__
RECAPTCHA_SITE_KEY=__REQUIRED__

# Discord hooks and roles
RERATE_ANNOUNCEMENT_HOOK=__REQUIRED__
LEVEL_SUBMISSION_HOOK=__REQUIRED__
PASS_SUBMISSION_HOOK=__REQUIRED__
LEVEL_FILE_UPDATE_HOOK=__REQUIRED__
# Zen Mode media-report webhook (optional; reports return 503 if unset)
RATING_ZEN_REPORT_WEBHOOK_URL=
# Public mod catalog reports
MOD_REPORT_WEBHOOK_URL=__REQUIRED__
# Official raters who reach 100 ratings in a UTC month (TUFStellar nominee notice)
TUFSTELLAR_NOMINEES_WEBHOOK_URL=
UNIVERSAL_PING_ROLE_ID=
GALACTIC_PING_ROLE_ID=
PLANETARY_PING_ROLE_ID=
RERATE_PING_ROLE_ID=
DISCORD_ANNOUNCEMENT_DELIVERY_FORCE=false
DISCORD_ANNOUNCEMENT_WEBHOOK_OVERRIDE=

# External APIs
YOUTUBE_API_KEY=__REQUIRED__
IMAGE_API=
BILIBILI_API=
BILIBILI_PROXY_PROBE_BVID=BV1zCtq61Eoi
BILIBILI_PROXY_WAVE_TIMEOUT_MS=8000
# BILIBILI_PROXY_DISABLED=1
# BILIBILI_PROXY_ENABLED=1
# BILIBILI_PROXY_LOGGING=false
ICON_IMAGE_API=
HYONSU_BOT_URL=
HYONSU_BOT_TOKEN=
OWOSEAN_API_URL=
AUTORATER_UUID=
BOT_AVATAR_URL=
CURATION_CHECKLIST_ASSIGNED_BY=
STEAM_WORKSHOP_AGENT_URL=
STEAM_WORKSHOP_AGENT_SECRET=
STEAM_WORKSHOP_AGENT_TIMEOUT_MS=30000
STEAM_WORKSHOP_APP_ID=

# Mail
MAILERSEND_API_TOKEN=__REQUIRED__
MAILERSEND_FROM_EMAIL=__REQUIRED__

# Elasticsearch
ELASTICSEARCH_URL=https://127.0.0.1:9200
ELASTICSEARCH_USERNAME=__REQUIRED__
ELASTICSEARCH_PASSWORD=__REQUIRED__
ELASTICSEARCH_CA_PATH=/run/secrets/elasticsearch-ca.crt
ELASTICSEARCH_INDEX_PREFIX=
ES_RECONCILE_CRON_DISABLED=false

# Stripe
STRIPE_SECRET_KEY=__REQUIRED__
STRIPE_WEBHOOK_SECRET=__REQUIRED__
STRIPE_CHECKOUT_SUCCESS_URL=https://tuforums.com/settings/subscription/success
STRIPE_CHECKOUT_CANCEL_URL=https://tuforums.com/settings/subscription
STRIPE_TUFSTELLAR_PRICE_IDS=__REQUIRED__
STRIPE_PRICE_TUFSTELLAR_1M=
STRIPE_PRICE_TUFSTELLAR_2M=
STRIPE_PRICE_TUFSTELLAR_3M=
STRIPE_PRICE_TUFSTELLAR_6M=
STRIPE_PRICE_TUFSTELLAR_9M=
STRIPE_PRICE_TUFSTELLAR_12M=

# Feature flags and scheduled jobs
APRIL_FOOLS=false
CUSTOM_PROFILE_BANNERS_ENABLED=true
TUF_STELLAR_ENABLED=true
# Off while Google verifies youtube.readonly. Set true after approval.
YOUTUBE_CHANNEL_LINKING_ENABLED=false

# Web Push (VAPID). Distinct keys per environment. Generate with:
# npx web-push generate-vapid-keys
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@tuforums.com
CDC_PROJECTORS_DISABLED=false
CDC_PROJECTOR_TABLES=
LEADERBOARD_RANK_SNAPSHOT_CRON_DISABLED=false
WEEKLY_CURATION_SCHEDULE_CRON_DISABLED=false
JOB_PROGRESS_TTL_SECONDS=86400

# Community tag voting (Wilson lower bound). Threshold changes require rematerialize then reindex.
COMMUNITY_TAG_WILSON_Z=1.96
COMMUNITY_TAG_SCORE_ON=0.45
COMMUNITY_TAG_SCORE_OFF=0.35
COMMUNITY_TAG_CARD_CAP=7
COMMUNITY_TAG_CLEARER_WEIGHT=10
COMMUNITY_TAG_DEFAULT_WEIGHT=1

# Sentry (node-api). Empty DSN disables the SDK. Release is baked into the image (GIT_SHA).
SENTRY_DSN=__REQUIRED__
SENTRY_ENVIRONMENT=production
SENTRY_SERVER_NAME=api
# Fraction of requests that create traces (Relay/Kafka volume). Default 0.05 in production.
SENTRY_TRACES_SAMPLE_RATE=0.05
# Among sampled traces, extra keep-rate for fast OK ones. Does not cut span ingest.
SENTRY_TRACES_FAST_SAMPLE_RATE=0.05
# SLOW_ENDPOINT_THRESHOLD_MS=3000

# Legacy API documentation and placeholder settings
API_DOCS_PORT=3089
API_DOCS_URL=https://api.tuforums.com/docs
PLACEHOLDER_PREFIX=
PLACEHOLDER_BODY=
PLACEHOLDER_POSTFIX=
