CDN_PORT=3001
CDN_BIND_ADDRESS=127.0.0.1

# Overrides common.env. DML on DB_DATABASE + DB_LOGGING_DATABASE only.
DB_USER=__REQUIRED__
DB_PASSWORD=__REQUIRED__

# Sentry (node-cdn). Empty DSN disables the SDK. Release is baked into the image (GIT_SHA).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SERVER_NAME=cdn
SENTRY_TRACES_FAST_SAMPLE_RATE=0.05

