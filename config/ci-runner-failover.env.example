# Copy to /srv/tuf/config/ci-runner-failover.env on tuf-main-server (mode 0600).
# Used by bin/tuf-ci-runner-failover / systemd timer.

# Token that can:
#   - read org self-hosted runners  (classic: admin:org)
#   - create/update org Actions variables (classic: admin:org)
# Fine-grained alternative: Organization permissions
#   Self-hosted runners: Read, Variables: Write
# If runners API returns 403, set HEALTH_MODE=host (Tailscale ping only).
GITHUB_TOKEN=

GITHUB_ORG=T21C
RUNNER_NAME=pop-os-sentry-host
TAILSCALE_HOST=pop-os
TAILSCALE_IP=100.123.141.2

# auto = prefer GitHub runner API, fall back to host ping on 403
# host = Tailscale/ping only
# api  = require runner "online" via API (no fallback)
HEALTH_MODE=auto

# JSON arrays for: runs-on: ${{ fromJSON(vars.CI_RUNS_ON) }}
SELF_HOSTED_JSON=["self-hosted","linux","tuf"]
GITHUB_HOSTED_JSON=["ubuntu-latest"]

FAIL_STREAK_REQUIRED=2

# org = one org Actions variable (recommended with org runner)
# repos = set CI_RUNS_ON on each repo listed in REPOS
SCOPE=org
REPOS=T21C/tuf-backend T21C/t21c-web-frontend T21C/tuf-infra

STATE_FILE=/var/lib/tuf/ci-runner-failover.state
