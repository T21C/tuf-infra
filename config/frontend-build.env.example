# Vite app config for production Docker builds (GitHub Actions).
# Store as repo secret FRONTEND_BUILD_ENV_PRODUCTION (multiline).
# Do NOT put Sentry token/DSN here — those are discrete secrets (see below).
#
# Repo secrets:
#   FRONTEND_BUILD_ENV_PRODUCTION  — this file's Vite URLs/flags
#   SENTRY_AUTH_TOKEN              — org token (Project:Read/Write + Release:Admin)
#   VITE_SENTRY_DSN                — browser DSN (baked into the bundle)
#
# Optional repo variables (defaults match vite.config.js / EU):
#   SENTRY_ORG=the-universal-forums
#   SENTRY_PROJECT=javascript-react
#   SENTRY_URL=https://de.sentry.io
#
# Deploy/promote merges these into one .env.production and injects
# GITHUB_SHA + SENTRY_RELEASE + SENTRY_REQUIRE_UPLOAD=1.

VITE_API_URL=https://api.tuforums.com
VITE_HEALTH_URL=https://api.tuforums.com
VITE_DEV_API_URL=https://api.tuforums.com
VITE_STAGING_API_URL=https://api.staging.tuforums.com
VITE_PROD_API_URL=https://api.tuforums.com
VITE_OWN_URL=https://tuforums.com
VITE_OWN_DEV_URL=http://127.0.0.1:5173
VITE_OWN_STAGING_URL=https://staging.tuforums.com
VITE_OWN_PROD_URL=https://tuforums.com
VITE_CDN_URL=https://cdn.tuforums.com
VITE_DEV_CDN_URL=https://cdn.tuforums.com
VITE_PROD_CDN_URL=https://cdn.tuforums.com
VITE_APRIL_FOOLS=false
VITE_CUSTOM_PROFILE_BANNERS_ENABLED=true
VITE_RECAPTCHA_SITE_KEY=__REQUIRED__
