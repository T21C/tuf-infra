#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "run this command as root" >&2
  exit 77
fi

if command -v docker >/dev/null && /usr/bin/docker compose version >/dev/null 2>&1; then
  echo "Docker Engine and Compose are already installed"
  exit 0
fi

/usr/bin/apt-get update

compose_package=
for candidate in docker-compose-v2 docker-compose-plugin; do
  if /usr/bin/apt-cache show "$candidate" >/dev/null 2>&1; then
    compose_package=$candidate
    break
  fi
done

[[ -n $compose_package ]] || {
  echo "no Docker Compose v2 package is available from the configured APT repositories" >&2
  exit 69
}

DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install -y --no-install-recommends \
  docker.io \
  "$compose_package"

/usr/bin/systemctl enable --now docker.service
/usr/bin/docker version
/usr/bin/docker compose version

echo "Docker installed without granting tuf-deploy direct daemon access"
