#!/usr/bin/env bash
set -Eeuo pipefail

readonly config_dir=${TUF_CONFIG_DIR:-/srv/tuf/config}
readonly example_dir=${TUF_CONFIG_EXAMPLE_DIR:-/srv/tuf/infra/config}
readonly config_names=(stack common redis storage api cdn cdc health thumbnail-worker)

errors=0

fail() {
  echo "error: $*" >&2
  errors=$((errors + 1))
}

value_of() {
  local file=$1 key=$2 line
  line=$(/usr/bin/grep -m1 -E "^${key}=" "$file" || true)
  /usr/bin/printf '%s' "${line#*=}"
}

for name in "${config_names[@]}"; do
  example="$example_dir/$name.env.example"
  actual="$config_dir/$name.env"

  [[ -f $example ]] || {
    fail "missing example file: $example"
    continue
  }
  [[ -f $actual ]] || {
    fail "missing config file: $actual"
    continue
  }

  duplicate_keys=$(/usr/bin/awk -F= '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    /^[A-Z][A-Z0-9_]*=/ { count[$1]++ }
    END { for (key in count) if (count[key] > 1) print key }
  ' "$actual")
  [[ -z $duplicate_keys ]] || fail "$actual has duplicate keys: ${duplicate_keys//$'\n'/, }"

  while IFS='=' read -r key example_value; do
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || continue
    line=$(/usr/bin/grep -m1 -E "^${key}=" "$actual" || true)
    if [[ -z $line ]]; then
      fail "$actual is missing $key"
      continue
    fi

    value=${line#*=}
    if [[ $example_value == __REQUIRED__ && ( -z $value || $value == __REQUIRED__ ) ]]; then
      fail "$actual requires a value for $key"
    fi
    if [[ $value == *replace-with-git-sha* ]]; then
      fail "$actual still has the placeholder for $key"
    fi
  done <"$example"

  permissions=$(/usr/bin/stat -c '%a' "$actual")
  if (( permissions % 10 != 0 )); then
    fail "$actual must not be world-readable (current mode: $permissions)"
  fi
done

render_mode=$(value_of "$config_dir/api.env" THUMBNAIL_RENDER_MODE)
[[ $render_mode == local || $render_mode == queue ]] || \
  fail "THUMBNAIL_RENDER_MODE in $config_dir/api.env must be local or queue"

worker_env=$config_dir/thumbnail-worker.env
queue_name=$(value_of "$worker_env" THUMBNAIL_QUEUE_NAME)
queue_prefix=$(value_of "$worker_env" THUMBNAIL_QUEUE_PREFIX)
[[ $queue_name =~ ^[A-Za-z0-9_-]+$ ]] || \
  fail "THUMBNAIL_QUEUE_NAME must contain only letters, numbers, underscores, or hyphens"
[[ $queue_prefix =~ ^[A-Za-z0-9_-]+$ ]] || \
  fail "THUMBNAIL_QUEUE_PREFIX must contain only letters, numbers, underscores, or hyphens"
[[ $(value_of "$worker_env" THUMBNAIL_WORKER_BIND_ADDRESS) == 127.0.0.1 ]] || \
  fail "THUMBNAIL_WORKER_BIND_ADDRESS must be 127.0.0.1"
[[ $(value_of "$worker_env" THUMBNAIL_WORKER_CONCURRENCY) == 1 ]] || \
  fail "THUMBNAIL_WORKER_CONCURRENCY must be 1 on this host"
[[ $(value_of "$worker_env" THUMBNAIL_JOB_INPUT_PATH) == /srv/tuf/data/cache/thumbnail-render-inputs ]] || \
  fail "THUMBNAIL_JOB_INPUT_PATH must use the shared cache mount"
[[ $(value_of "$worker_env" THUMBNAILS_CACHE_PATH) == /srv/tuf/data/thumbnails ]] || \
  fail "THUMBNAILS_CACHE_PATH in thumbnail-worker.env must use the shared thumbnails mount"

for numeric_key in \
  THUMBNAIL_WORKER_PORT \
  THUMBNAIL_JOB_ATTEMPTS \
  THUMBNAIL_JOB_MAX_HTML_BYTES \
  THUMBNAIL_JOB_MAX_DIMENSION \
  THUMBNAIL_QUEUE_MAX_WAITING \
  THUMBNAIL_REQUEST_WAIT_MS \
  THUMBNAIL_OG_REQUEST_WAIT_MS \
  THUMBNAIL_OUTPUT_POLL_MS; do
  numeric_value=$(value_of "$worker_env" "$numeric_key")
  [[ $numeric_value =~ ^[1-9][0-9]*$ ]] || fail "$numeric_key must be a positive integer"
done

worker_port=$(value_of "$worker_env" THUMBNAIL_WORKER_PORT)
if [[ $worker_port =~ ^[1-9][0-9]*$ ]] && (( worker_port > 65535 )); then
  fail "THUMBNAIL_WORKER_PORT must be at most 65535"
fi

for required_path in \
  /srv/tuf/data/cache \
  /srv/tuf/data/thumbnails \
  /srv/tuf/data/logs \
  /srv/tuf/data/cdn-temp \
  /srv/tuf/data/backups \
  /srv/tuf/data/mapping-hashes; do
  [[ -d $required_path ]] || fail "missing data directory: $required_path"
done

[[ -f /srv/tuf/config/certs/elasticsearch.crt ]] || fail "missing Elasticsearch CA certificate"
[[ -r /srv/tuf/config/secrets/google-application-credentials.json ]] || fail "missing Google application credentials"

if (( errors > 0 )); then
  echo "$errors configuration error(s) found" >&2
  exit 78
fi

echo "TUF configuration is valid"
