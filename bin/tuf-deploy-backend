#!/usr/bin/env bash
set -Eeuo pipefail

readonly INFRA_DIR=/srv/tuf/infra
readonly STACK_ENV=/srv/tuf/config/stack.env
readonly LOCK_FILE=/run/lock/tuf-deploy.lock
readonly STACK_UNIT=tuf-stack.service
readonly COMPOSE=(/usr/bin/docker compose --env-file "$STACK_ENV" -f "$INFRA_DIR/compose.yml")
readonly BACKEND_SERVICES=(api cdn cdc health thumbnail-worker bilibili-proxy)

if [[ $# -ne 1 || ! $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{6,127}$ ]]; then
  echo "usage: tuf-deploy-backend <immutable-image-tag>" >&2
  exit 64
fi

readonly requested_tag=$1
exec 9>"$LOCK_FILE"
if ! /usr/bin/flock -n 9; then
  echo "another TUF deployment is running; waiting up to 900s" >&2
  /usr/bin/flock -w 900 9 || {
    echo "timed out waiting for another TUF deployment to finish" >&2
    exit 75
  }
fi

if ! /usr/bin/systemctl is-enabled --quiet "$STACK_UNIT"; then
  echo "$STACK_UNIT is not enabled; refusing production deployment before explicit cutover" >&2
  exit 78
fi
if ! /usr/bin/systemctl is-active --quiet "$STACK_UNIT"; then
  echo "$STACK_UNIT is not active; refusing production deployment" >&2
  exit 78
fi

previous_tag=$(/usr/bin/awk -F= '$1 == "TUF_BACKEND_IMAGE_TAG" { print $2; exit }' "$STACK_ENV")
if [[ -z $previous_tag ]]; then
  echo "TUF_BACKEND_IMAGE_TAG is missing from $STACK_ENV" >&2
  exit 78
fi

set_tag() {
  local tag=$1
  local temporary
  temporary=$(/usr/bin/mktemp "${STACK_ENV}.XXXXXX")
  /usr/bin/awk -F= -v tag="$tag" '
    BEGIN { changed = 0 }
    $1 == "TUF_BACKEND_IMAGE_TAG" { print "TUF_BACKEND_IMAGE_TAG=" tag; changed = 1; next }
    { print }
    END { if (!changed) exit 1 }
  ' "$STACK_ENV" >"$temporary"
  /usr/bin/chown --reference="$STACK_ENV" "$temporary"
  /usr/bin/chmod --reference="$STACK_ENV" "$temporary"
  /usr/bin/mv -f "$temporary" "$STACK_ENV"
}

rollback() {
  echo "deployment failed; rolling back to $previous_tag" >&2
  set_tag "$previous_tag"
  if ! "${COMPOSE[@]}" pull "${BACKEND_SERVICES[@]}"; then
    echo "rollback failed while pulling backend image $previous_tag" >&2
    return 1
  fi
  if ! /usr/bin/systemctl reload "$STACK_UNIT"; then
    echo "rollback failed while reloading $STACK_UNIT with $previous_tag" >&2
    return 1
  fi
  echo "rolled back backend to $previous_tag" >&2
}

fail_with_rollback() {
  local reason=$1
  echo "$reason" >&2
  if ! rollback; then
    echo "automatic rollback failed; inspect $STACK_UNIT and $STACK_ENV immediately" >&2
  fi
  exit 1
}

set_tag "$requested_tag"
if ! "${COMPOSE[@]}" pull "${BACKEND_SERVICES[@]}"; then
  fail_with_rollback "backend image pull failed"
fi

# Migrate on the new image before the old containers are replaced. Services are still
# running the previous tag here, so migrations must be forward-compatible (expand now,
# drop columns in a later release).
if ! "${COMPOSE[@]}" run --rm --no-deps migrate; then
  fail_with_rollback "database migration failed; not reloading production services"
fi

if ! /usr/bin/systemctl reload "$STACK_UNIT"; then
  fail_with_rollback "$STACK_UNIT reload failed"
fi

echo "backend deployed: $requested_tag"
