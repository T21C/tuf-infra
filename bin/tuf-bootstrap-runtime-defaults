#!/usr/bin/env bash
set -Eeuo pipefail

# One-time, root-authenticated repair for hosts whose config predates the
# current infra schema. This only inserts documented non-secret defaults; it
# never replaces an existing value and never reloads services.

readonly INFRA_DIR=/srv/tuf/infra
readonly CONFIG_DIR=/srv/tuf/config
readonly STACK_ENV="$CONFIG_DIR/stack.env"
readonly CONFIG_CHECK="$INFRA_DIR/bin/tuf-config-check"
readonly COMPOSE=(/usr/bin/docker compose --env-file "$STACK_ENV" -f "$INFRA_DIR/compose.yml")
readonly CONFIG_FILES=(
  "$CONFIG_DIR/api.env"
  "$CONFIG_DIR/cdn.env"
  "$CONFIG_DIR/thumbnail-worker.env"
)

fail() {
  echo "error: $*" >&2
  exit 64
}

if [[ $EUID -ne 0 ]]; then
  echo "run this command as root" >&2
  exit 77
fi

for config_file in "${CONFIG_FILES[@]}"; do
  [[ -f $config_file ]] || fail "missing $config_file"
done
[[ -f $STACK_ENV ]] || fail "missing $STACK_ENV"
[[ -x $CONFIG_CHECK ]] || fail "missing executable $CONFIG_CHECK"

declare -A backups=()
for config_file in "${CONFIG_FILES[@]}"; do
  backup=$(/usr/bin/mktemp "${config_file}.runtime-defaults-backup.XXXXXX")
  /usr/bin/cp --preserve=mode,ownership "$config_file" "$backup"
  backups[$config_file]=$backup
done

restore_backups() {
  local config_file
  for config_file in "${CONFIG_FILES[@]}"; do
    /usr/bin/mv -f "${backups[$config_file]}" "$config_file"
  done
}

discard_backups() {
  local config_file
  for config_file in "${CONFIG_FILES[@]}"; do
    /usr/bin/rm -f "${backups[$config_file]}"
  done
}

upsert_missing() {
  local config_file=$1
  shift
  local key value line current_key temporary
  declare -A additions=()
  declare -A seen=()

  while (( $# > 0 )); do
    key=$1
    value=$2
    additions[$key]=$value
    shift 2
  done

  temporary=$(/usr/bin/mktemp "${config_file}.runtime-defaults.XXXXXX")
  while IFS= read -r line || [[ -n $line ]]; do
    current_key=${line%%=*}
    if [[ -n $current_key ]] && [[ -n ${additions[$current_key]+present} ]]; then
      /usr/bin/printf '%s=%s\n' "$current_key" "${additions[$current_key]}"
      seen[$current_key]=1
    else
      /usr/bin/printf '%s\n' "$line"
    fi
  done <"$config_file" >"$temporary"

  for key in "${!additions[@]}"; do
    [[ -n ${seen[$key]+present} ]] || /usr/bin/printf '%s=%s\n' "$key" "${additions[$key]}" >>"$temporary"
  done

  /usr/bin/chown --reference="$config_file" "$temporary"
  /usr/bin/chmod --reference="$config_file" "$temporary"
  /usr/bin/mv -f "$temporary" "$config_file"
}

upsert_missing "$CONFIG_DIR/api.env" \
  THUMBNAIL_REQUEST_WAIT_MS 5000 \
  THUMBNAIL_OG_REQUEST_WAIT_MS 15000 \
  THUMBNAIL_GENERATION_WAIT_MS 600000 \
  YOUTUBE_CHANNEL_LINKING_ENABLED false \
  VAPID_SUBJECT mailto:noreply@tuforums.com \
  COMMUNITY_TAG_WILSON_Z 1.96 \
  COMMUNITY_TAG_SCORE_ON 0.45 \
  COMMUNITY_TAG_SCORE_OFF 0.35 \
  COMMUNITY_TAG_CARD_CAP 7 \
  COMMUNITY_TAG_CLEARER_WEIGHT 10 \
  COMMUNITY_TAG_DEFAULT_WEIGHT 1

upsert_missing "$CONFIG_DIR/cdn.env" \
  PACK_DOWNLOAD_MAX_CONCURRENT_JOBS 2 \
  PACK_DOWNLOAD_PARALLELISM 4 \
  CDN_7Z_THREADS 2

upsert_missing "$CONFIG_DIR/thumbnail-worker.env" \
  THUMBNAIL_GENERATION_WAIT_MS 600000 \
  THUMBNAIL_JOB_LOCK_MS 180000

if ! "$CONFIG_CHECK"; then
  restore_backups
  echo "runtime-default bootstrap was rejected; restored the previous configuration" >&2
  exit 78
fi

if ! "${COMPOSE[@]}" config --quiet; then
  restore_backups
  echo "runtime-default bootstrap did not render the Compose model; restored the previous configuration" >&2
  exit 78
fi

discard_backups
echo "runtime defaults stored; re-run the tuf-infra main workflow to sync the current checkout"
