#!/usr/bin/env bash
# Publish org/repo variable CI_RUNS_ON as exactly one runs-on label set.
# Actions matches every label (AND) and will not fall through a mixed list.
#
# Preference, from the org runners API:
#   1. online runner with every ARM64_JSON label
#   2. online runner with every SELF_HOSTED_JSON label
#   3. GITHUB_HOSTED_JSON (ubuntu-latest)
# Moving down a tier waits for FAIL_STREAK_REQUIRED failures. Moving up applies
# on the next run. Jobs already queued keep the label set they started with.
#
# Config: /srv/tuf/config/ci-runner-failover.env (see config/ci-runner-failover.env.example)
set -Eeuo pipefail

readonly CONFIG_FILE="${TUF_CI_FAILOVER_ENV:-/srv/tuf/config/ci-runner-failover.env}"

load_config() {
  [[ -f $CONFIG_FILE ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == *=* ]] || continue
    key=${line%%=*}
    val=${line#*=}
    key="${key%"${key##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    if [[ $val == \'*\' ]]; then
      val=${val:1:-1}
    elif [[ $val == \"*\" ]]; then
      val=${val:1:-1}
    fi
    printf -v "$key" '%s' "$val"
    export "$key"
  done <"$CONFIG_FILE"
}

load_config

: "${GITHUB_ORG:=T21C}"
: "${RUNNER_NAME:=pop-os-sentry-host}"
: "${TAILSCALE_HOST:=pop-os}"
: "${TAILSCALE_IP:=100.123.141.2}"
: "${ARM64_JSON:=[\"self-hosted\",\"linux\",\"ARM64\",\"tuf\"]}"
: "${SELF_HOSTED_JSON:=[\"self-hosted\",\"linux\",\"tuf\"]}"
: "${GITHUB_HOSTED_JSON:=[\"ubuntu-latest\"]}"
: "${FAIL_STREAK_REQUIRED:=2}"
: "${STATE_FILE:=/var/lib/tuf/ci-runner-failover.state}"
: "${SCOPE:=org}" # org | repos
: "${REPOS:=T21C/tuf-backend T21C/t21c-web-frontend T21C/tuf-infra}"
# host = Tailscale/ping only; api = also require runner "online" via GitHub API
: "${HEALTH_MODE:=auto}" # auto | host | api

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 66
  }
}

b64enc() { printf '%s' "$1" | base64 | tr -d '\n'; }
b64dec() {
  local in=$1 out
  [[ -n $in ]] || return 1
  if ! out=$(printf '%s' "$in" | base64 -d 2>/dev/null); then
    return 1
  fi
  printf '%s' "$out"
}

need_cmd curl
need_cmd jq

canonicalize_json() {
  local name=$1 value=$2 canon
  if ! canon=$(jq -c . <<<"$value" 2>/dev/null); then
    echo "$name is not valid JSON: $value" >&2
    exit 64
  fi
  if ! jq -e 'type == "array" and all(.[]; type == "string") and length > 0' >/dev/null <<<"$canon"; then
    echo "$name must be a non-empty JSON array of strings: $value" >&2
    exit 64
  fi
  printf -v "$name" '%s' "$canon"
}

canonicalize_json ARM64_JSON "$ARM64_JSON"
canonicalize_json SELF_HOSTED_JSON "$SELF_HOSTED_JSON"
canonicalize_json GITHUB_HOSTED_JSON "$GITHUB_HOSTED_JSON"

if [[ -z ${GITHUB_TOKEN:-} ]]; then
  echo "GITHUB_TOKEN is unset (set in $CONFIG_FILE)" >&2
  exit 78
fi

# Sets API_HTTP_CODE + API_BODY (globals). Do NOT call inside $() — that loses globals.
API_HTTP_CODE=
API_BODY=
api() {
  local method=$1 path=$2
  shift 2
  local tmp code
  tmp=$(mktemp)
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -X "$method" \
    "https://api.github.com${path}" \
    "$@" || true)
  API_HTTP_CODE=${code:-000}
  API_BODY=$(cat "$tmp" 2>/dev/null || true)
  rm -f "$tmp"
  [[ $API_HTTP_CODE =~ ^[23] ]]
}

host_reachable() {
  if command -v tailscale >/dev/null 2>&1; then
    if tailscale ping -c 1 -timeout 3s "$TAILSCALE_HOST" >/dev/null 2>&1; then
      return 0
    fi
    if tailscale ping -c 1 -timeout 3s "$TAILSCALE_IP" >/dev/null 2>&1; then
      return 0
    fi
  fi
  ping -c 1 -W 2 "$TAILSCALE_IP" >/dev/null 2>&1
}

# Sets TIER to arm, self, or hosted. Return 2 when the runners API cannot be read.
classify_runners() {
  local page=1 combined='[]' batch count parsed
  while (( page <= 20 )); do
    api GET "/orgs/${GITHUB_ORG}/actions/runners?per_page=100&page=${page}" || true
    if [[ $API_HTTP_CODE != 200 ]]; then
      log "warn: GitHub runners API HTTP ${API_HTTP_CODE} (token needs org self-hosted runners read)"
      return 2
    fi
    batch=$(jq -c '.runners // []' <<<"$API_BODY")
    count=$(jq -r 'length' <<<"$batch")
    combined=$(jq -cn --argjson a "$combined" --argjson b "$batch" '$a + $b')
    if (( count < 100 )); then
      break
    fi
    page=$((page + 1))
  done

  if ! parsed=$(jq -c --argjson arm "$ARM64_JSON" --argjson self "$SELF_HOSTED_JSON" '
    def has_all($names; $need):
      all(($need | map(ascii_downcase))[]; . as $n | $names | index($n));
    [
      .[]
      | select((.status // "" | ascii_downcase) == "online")
      | . as $runner
      | [($runner.labels // [])[]?.name | ascii_downcase] as $names
      | $runner + {names: $names}
    ] as $online
    | {
        arm: [$online[] | select(has_all(.names; $arm)) | .name],
        self: [$online[] | select(has_all(.names; $self)) | .name]
      }
  ' <<<"$combined"); then
    log "error: could not classify runners"
    return 2
  fi

  local arm_names self_names
  arm_names=$(jq -r '.arm | join(",")' <<<"$parsed")
  self_names=$(jq -r '.self | join(",")' <<<"$parsed")
  if [[ -n $arm_names ]]; then
    TIER=arm
  elif [[ -n $self_names ]]; then
    TIER=self
  else
    TIER=hosted
  fi
  log "api tier=$TIER arm=${arm_names:--} self=${self_names:--}"
}

# Host ping cannot see architecture. It only distinguishes "some self-hosted" from "hosted".
resolve_tier() {
  local mode=$HEALTH_MODE st
  if [[ $mode == host ]]; then
    if host_reachable; then
      TIER=self
      log "host mode: $RUNNER_NAME ($TAILSCALE_HOST) reachable; using any self-hosted"
    else
      TIER=hosted
      log "host mode: $RUNNER_NAME unreachable ($TAILSCALE_HOST / $TAILSCALE_IP)"
    fi
    return 0
  fi

  set +e
  classify_runners
  st=$?
  set -e
  if [[ $st -eq 0 ]]; then
    return 0
  fi

  if [[ $mode == api ]]; then
    TIER=hosted
    log "api required but unavailable; treating fleet as down"
    return 0
  fi

  if [[ $mode != auto ]]; then
    echo "HEALTH_MODE must be auto, host, or api (got: $mode)" >&2
    exit 64
  fi

  if host_reachable; then
    TIER=self
    log "api unavailable; host reachable; using any self-hosted"
  else
    TIER=hosted
    log "api unavailable; host unreachable ($TAILSCALE_HOST / $TAILSCALE_IP)"
  fi
}

rank_of_tier() {
  case $1 in
    arm) echo 3 ;;
    self) echo 2 ;;
    hosted) echo 1 ;;
    *) echo 0 ;;
  esac
}

tier_of_json() {
  local value=$1
  if [[ $value == "$ARM64_JSON" ]]; then
    echo arm
  elif [[ $value == "$SELF_HOSTED_JSON" ]]; then
    echo self
  elif [[ $value == "$GITHUB_HOSTED_JSON" ]]; then
    echo hosted
  else
    echo unknown
  fi
}

json_of_tier() {
  case $1 in
    arm) printf '%s' "$ARM64_JSON" ;;
    self) printf '%s' "$SELF_HOSTED_JSON" ;;
    hosted) printf '%s' "$GITHUB_HOSTED_JSON" ;;
    *)
      echo "unknown tier: $1" >&2
      exit 64
      ;;
  esac
}

read_fail_streak() {
  if [[ -f $STATE_FILE ]]; then
    awk -F= '/^fail_streak=/ {print $2}' "$STATE_FILE" | tail -1
  else
    echo 0
  fi
}

read_prev_desired() {
  if [[ -f $STATE_FILE ]]; then
    local line b64 decoded
    # Base64 padding contains "="; split only on the first equals sign.
    line=$(grep -m1 '^desired_b64=' "$STATE_FILE" || true)
    b64=${line#desired_b64=}
    if decoded=$(b64dec "$b64" 2>/dev/null) && [[ -n $decoded ]] && decoded=$(jq -c . <<<"$decoded" 2>/dev/null); then
      printf '%s' "$decoded"
      return 0
    fi
  fi
  return 1
}

write_state() {
  local desired=$1 streak=$2
  mkdir -p "$(dirname "$STATE_FILE")"
  cat >"$STATE_FILE" <<EOF
desired_b64=$(b64enc "$desired")
fail_streak=$streak
updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
}

get_org_var() {
  api GET "/orgs/${GITHUB_ORG}/actions/variables/CI_RUNS_ON" || true
  if [[ $API_HTTP_CODE == 404 ]]; then
    printf ''
    return 0
  fi
  if [[ $API_HTTP_CODE != 200 ]]; then
    log "error: get org variable HTTP $API_HTTP_CODE"
    return 1
  fi
  jq -r '.value // empty' <<<"$API_BODY"
}

set_org_var() {
  local value=$1
  local current
  current=$(get_org_var) || return 1
  if [[ $current == "$value" ]]; then
    log "org CI_RUNS_ON already $value"
    return 0
  fi
  local body
  body=$(jq -nc --arg v "$value" '{name:"CI_RUNS_ON",value:$v}')
  if [[ -n $current ]]; then
    api PATCH "/orgs/${GITHUB_ORG}/actions/variables/CI_RUNS_ON" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  else
    body=$(jq -nc --arg v "$value" '{name:"CI_RUNS_ON",value:$v,visibility:"all"}')
    api POST "/orgs/${GITHUB_ORG}/actions/variables" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  fi
  if [[ $API_HTTP_CODE =~ ^2 ]]; then
    log "set org CI_RUNS_ON -> $value"
    return 0
  fi
  log "error: set org CI_RUNS_ON HTTP ${API_HTTP_CODE} — token needs org Actions variables write (classic: admin:org)"
  return 1
}

set_repo_var() {
  local repo=$1 value=$2
  local owner=${repo%/*} name=${repo#*/}
  local current body
  api GET "/repos/${owner}/${name}/actions/variables/CI_RUNS_ON" || true
  if [[ $API_HTTP_CODE == 404 ]]; then
    current=
  elif [[ $API_HTTP_CODE == 200 ]]; then
    current=$(jq -r '.value // empty' <<<"$API_BODY")
  else
    log "error: get $repo variable HTTP $API_HTTP_CODE"
    return 1
  fi
  if [[ $current == "$value" ]]; then
    log "repo $repo CI_RUNS_ON already $value"
    return 0
  fi
  body=$(jq -nc --arg v "$value" '{name:"CI_RUNS_ON",value:$v}')
  if [[ -n $current ]]; then
    api PATCH "/repos/${owner}/${name}/actions/variables/CI_RUNS_ON" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  else
    api POST "/repos/${owner}/${name}/actions/variables" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  fi
  if [[ $API_HTTP_CODE =~ ^2 ]]; then
    log "set $repo CI_RUNS_ON -> $value"
    return 0
  fi
  log "error: set $repo CI_RUNS_ON HTTP ${API_HTTP_CODE}"
  return 1
}

apply_value() {
  local value=$1
  case "$SCOPE" in
    org)
      set_org_var "$value"
      ;;
    repos)
      local repo rc=0
      for repo in $REPOS; do
        set_repo_var "$repo" "$value" || rc=1
      done
      return $rc
      ;;
    *)
      echo "SCOPE must be org or repos (got: $SCOPE)" >&2
      exit 64
      ;;
  esac
}

resolve_tier
target_rank=$(rank_of_tier "$TIER")
if prev=$(read_prev_desired); then
  prev_tier=$(tier_of_json "$prev")
  prev_rank=$(rank_of_tier "$prev_tier")
else
  prev=
  prev_tier=none
  prev_rank=0
fi

if (( target_rank >= prev_rank )); then
  streak=0
  desired=$(json_of_tier "$TIER")
  log "prefer $TIER"
else
  streak=$(read_fail_streak)
  streak=${streak:-0}
  streak=$((streak + 1))
  if ((streak >= FAIL_STREAK_REQUIRED)); then
    desired=$(json_of_tier "$TIER")
    log "downgrade streak=$streak (>= $FAIL_STREAK_REQUIRED); prefer $TIER"
  else
    desired=$prev
    log "downgrade streak=$streak (< $FAIL_STREAK_REQUIRED); holding $prev_tier ($desired)"
  fi
fi

write_state "$desired" "$streak"
apply_value "$desired"
