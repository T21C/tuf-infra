#!/usr/bin/env bash
# Flip GitHub Actions CI_RUNS_ON between self-hosted and ubuntu-latest based on
# laptop/runner reachability from the production host (Tailscale).
#
# Config: /srv/tuf/config/ci-runner-failover.env (see config/ci-runner-failover.env.example)
set -Eeuo pipefail

readonly CONFIG_FILE="${TUF_CI_FAILOVER_ENV:-/srv/tuf/config/ci-runner-failover.env}"

load_config() {
  [[ -f $CONFIG_FILE ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == *=* ]] || continue
    key=${line%%=*}
    val=${line#*=}
    key="${key%"${key##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    if [[ $val == \'*\' ]]; then
      val=${val:1:-1}
    elif [[ $val == \"*\" ]]; then
      val=${val:1:-1}
    fi
    printf -v "$key" '%s' "$val"
    export "$key"
  done <"$CONFIG_FILE"
}

load_config

: "${GITHUB_ORG:=T21C}"
: "${RUNNER_NAME:=pop-os-sentry-host}"
: "${TAILSCALE_HOST:=pop-os}"
: "${TAILSCALE_IP:=100.123.141.2}"
: "${SELF_HOSTED_JSON:=[\"self-hosted\",\"linux\",\"tuf\"]}"
: "${GITHUB_HOSTED_JSON:=[\"ubuntu-latest\"]}"
: "${FAIL_STREAK_REQUIRED:=2}"
: "${STATE_FILE:=/var/lib/tuf/ci-runner-failover.state}"
: "${SCOPE:=org}" # org | repos
: "${REPOS:=T21C/tuf-backend T21C/t21c-web-frontend T21C/tuf-infra}"
# host = Tailscale/ping only; api = also require runner "online" via GitHub API
: "${HEALTH_MODE:=auto}" # auto | host | api

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 66
  }
}

b64enc() { printf '%s' "$1" | base64 | tr -d '\n'; }
b64dec() {
  local in=$1 out
  [[ -n $in ]] || return 1
  if ! out=$(printf '%s' "$in" | base64 -d 2>/dev/null); then
    return 1
  fi
  printf '%s' "$out"
}

need_cmd curl
need_cmd jq

if [[ -z ${GITHUB_TOKEN:-} ]]; then
  echo "GITHUB_TOKEN is unset (set in $CONFIG_FILE)" >&2
  exit 78
fi

# Sets API_HTTP_CODE + API_BODY (globals). Do NOT call inside $() — that loses globals.
API_HTTP_CODE=
API_BODY=
api() {
  local method=$1 path=$2
  shift 2
  local tmp code
  tmp=$(mktemp)
  code=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -X "$method" \
    "https://api.github.com${path}" \
    "$@" || true)
  API_HTTP_CODE=${code:-000}
  API_BODY=$(cat "$tmp" 2>/dev/null || true)
  rm -f "$tmp"
  [[ $API_HTTP_CODE =~ ^[23] ]]
}

host_reachable() {
  if command -v tailscale >/dev/null 2>&1; then
    if tailscale ping -c 1 -timeout 3s "$TAILSCALE_HOST" >/dev/null 2>&1; then
      return 0
    fi
    if tailscale ping -c 1 -timeout 3s "$TAILSCALE_IP" >/dev/null 2>&1; then
      return 0
    fi
  fi
  ping -c 1 -W 2 "$TAILSCALE_IP" >/dev/null 2>&1
}

# 0 = online, 1 = offline/missing, 2 = API unauthorized/unavailable
runner_api_status() {
  api GET "/orgs/${GITHUB_ORG}/actions/runners?per_page=100" || true
  case "$API_HTTP_CODE" in
    401|403)
      log "warn: GitHub runners API HTTP $API_HTTP_CODE (token needs org self-hosted runners read)"
      return 2
      ;;
    200) ;;
    *)
      log "warn: GitHub runners API HTTP ${API_HTTP_CODE}"
      return 2
      ;;
  esac
  if jq -e --arg name "$RUNNER_NAME" '
    .runners
    | map(select(.name == $name))
    | length > 0 and all(.[]; .status == "online")
  ' >/dev/null <<<"$API_BODY"; then
    return 0
  fi
  return 1
}

healthy() {
  if ! host_reachable; then
    log "host unreachable ($TAILSCALE_HOST / $TAILSCALE_IP)"
    return 1
  fi
  log "host reachable"

  local mode=$HEALTH_MODE
  if [[ $mode == auto ]]; then
    mode=api
  fi

  if [[ $mode == host ]]; then
    return 0
  fi

  local st
  set +e
  runner_api_status
  st=$?
  set -e
  case $st in
    0) return 0 ;;
    1) return 1 ;;
    2)
      if [[ $HEALTH_MODE == auto ]]; then
        log "warn: falling back to host-only health (API unavailable)"
        return 0
      fi
      return 1
      ;;
  esac
  return 1
}

read_fail_streak() {
  if [[ -f $STATE_FILE ]]; then
    awk -F= '/^fail_streak=/ {print $2}' "$STATE_FILE" | tail -1
  else
    echo 0
  fi
}

read_prev_desired() {
  if [[ -f $STATE_FILE ]]; then
    local b64 decoded
    b64=$(awk -F= '/^desired_b64=/ {print $2}' "$STATE_FILE" | tail -1)
    if decoded=$(b64dec "$b64" 2>/dev/null) && [[ -n $decoded ]]; then
      printf '%s' "$decoded"
      return 0
    fi
  fi
  printf '%s' "$SELF_HOSTED_JSON"
}

write_state() {
  local desired=$1 streak=$2
  mkdir -p "$(dirname "$STATE_FILE")"
  cat >"$STATE_FILE" <<EOF
desired_b64=$(b64enc "$desired")
fail_streak=$streak
updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
}

get_org_var() {
  api GET "/orgs/${GITHUB_ORG}/actions/variables/CI_RUNS_ON" || true
  if [[ $API_HTTP_CODE == 404 ]]; then
    printf ''
    return 0
  fi
  if [[ $API_HTTP_CODE != 200 ]]; then
    log "error: get org variable HTTP $API_HTTP_CODE"
    return 1
  fi
  jq -r '.value // empty' <<<"$API_BODY"
}

set_org_var() {
  local value=$1
  local current
  current=$(get_org_var) || return 1
  if [[ $current == "$value" ]]; then
    log "org CI_RUNS_ON already $value"
    return 0
  fi
  local body
  body=$(jq -nc --arg v "$value" '{name:"CI_RUNS_ON",value:$v}')
  if [[ -n $current ]]; then
    api PATCH "/orgs/${GITHUB_ORG}/actions/variables/CI_RUNS_ON" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  else
    body=$(jq -nc --arg v "$value" '{name:"CI_RUNS_ON",value:$v,visibility:"all"}')
    api POST "/orgs/${GITHUB_ORG}/actions/variables" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  fi
  if [[ $API_HTTP_CODE =~ ^2 ]]; then
    log "set org CI_RUNS_ON -> $value"
    return 0
  fi
  log "error: set org CI_RUNS_ON HTTP ${API_HTTP_CODE} — token needs org Actions variables write (classic: admin:org)"
  return 1
}

set_repo_var() {
  local repo=$1 value=$2
  local owner=${repo%/*} name=${repo#*/}
  local current body
  api GET "/repos/${owner}/${name}/actions/variables/CI_RUNS_ON" || true
  if [[ $API_HTTP_CODE == 404 ]]; then
    current=
  elif [[ $API_HTTP_CODE == 200 ]]; then
    current=$(jq -r '.value // empty' <<<"$API_BODY")
  else
    log "error: get $repo variable HTTP $API_HTTP_CODE"
    return 1
  fi
  if [[ $current == "$value" ]]; then
    log "repo $repo CI_RUNS_ON already $value"
    return 0
  fi
  body=$(jq -nc --arg v "$value" '{name:"CI_RUNS_ON",value:$v}')
  if [[ -n $current ]]; then
    api PATCH "/repos/${owner}/${name}/actions/variables/CI_RUNS_ON" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  else
    api POST "/repos/${owner}/${name}/actions/variables" \
      -H 'Content-Type: application/json' \
      --data "$body" || true
  fi
  if [[ $API_HTTP_CODE =~ ^2 ]]; then
    log "set $repo CI_RUNS_ON -> $value"
    return 0
  fi
  log "error: set $repo CI_RUNS_ON HTTP ${API_HTTP_CODE}"
  return 1
}

apply_value() {
  local value=$1
  case "$SCOPE" in
    org)
      set_org_var "$value"
      ;;
    repos)
      local repo rc=0
      for repo in $REPOS; do
        set_repo_var "$repo" "$value" || rc=1
      done
      return $rc
      ;;
    *)
      echo "SCOPE must be org or repos (got: $SCOPE)" >&2
      exit 64
      ;;
  esac
}

if healthy; then
  streak=0
  desired=$SELF_HOSTED_JSON
  log "health ok; prefer self-hosted"
else
  streak=$(read_fail_streak)
  streak=${streak:-0}
  streak=$((streak + 1))
  if ((streak >= FAIL_STREAK_REQUIRED)); then
    desired=$GITHUB_HOSTED_JSON
    log "health fail streak=$streak (>= $FAIL_STREAK_REQUIRED); prefer github-hosted"
  else
    desired=$(read_prev_desired)
    log "health fail streak=$streak (< $FAIL_STREAK_REQUIRED); holding previous ($desired)"
  fi
fi

write_state "$desired" "$streak"
apply_value "$desired"
