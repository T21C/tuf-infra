#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "run this command as root" >&2
  exit 77
fi

upsert() {
  local file=$1 key=$2 value=$3 temporary
  [[ -f $file ]] || {
    echo "missing config: $file" >&2
    exit 66
  }
  temporary=$(/usr/bin/mktemp "${file}.XXXXXX")
  /usr/bin/awk -F= -v key="$key" -v value="$value" '
    $1 == key { print key "=" value; changed = 1; next }
    { print }
    END { if (!changed) print key "=" value }
  ' "$file" >"$temporary"
  /usr/bin/chown --reference="$file" "$temporary"
  /usr/bin/chmod --reference="$file" "$temporary"
  /usr/bin/mv -f "$temporary" "$file"
}

normalize_stack() {
  local config_dir=$1 data_root=$2 index_prefix=$3

  upsert "$config_dir/common.env" LOG_PATH "$data_root/logs"
  upsert "$config_dir/common.env" CDN_TEMP_ROOT "$data_root/cdn-temp"
  upsert "$config_dir/common.env" WORKSPACE_ROOT "$data_root/cdn-temp/tuf-workspaces"

  upsert "$config_dir/api.env" CACHE_PATH "$data_root/cache"
  upsert "$config_dir/api.env" THUMBNAILS_CACHE_PATH "$data_root/thumbnails"
  upsert "$config_dir/api.env" MYSQL_BACKUP_PATH "$data_root/backups/mysql"
  upsert "$config_dir/api.env" MYSQL_BACKUP_TEMP_PATH "$data_root/backups/tmp"
  upsert "$config_dir/api.env" FILES_BACKUP_PATH "$data_root/backups/files"
  upsert "$config_dir/api.env" ROOT_PATH /app
  upsert "$config_dir/api.env" ELASTICSEARCH_CA_PATH /run/secrets/elasticsearch-ca.crt
  upsert "$config_dir/api.env" TRANSLATIONS_PATH ""
  upsert "$config_dir/api.env" ELASTICSEARCH_INDEX_PREFIX "$index_prefix"
  upsert "$config_dir/thumbnail-worker.env" THUMBNAIL_JOB_INPUT_PATH /srv/tuf/data/cache/thumbnail-render-inputs
  upsert "$config_dir/thumbnail-worker.env" THUMBNAILS_CACHE_PATH /srv/tuf/data/thumbnails
  upsert "$config_dir/storage.env" PACK_CDN_ROOT "$data_root/cdn-temp/packs"
}

# Both stacks use the same paths inside their containers. Compose isolates the
# backing host directories through TUF_DATA_ROOT bind-mount sources.
normalize_stack /srv/tuf/config /srv/tuf/data ""
normalize_stack /srv/tuf/config/canary /srv/tuf/data tuf_canary_
upsert /srv/tuf/config/canary/api.env CDC_PROJECTORS_DISABLED 1
upsert /srv/tuf/config/canary/api.env ES_RECONCILE_CRON_DISABLED 1
upsert /srv/tuf/config/canary/api.env LEADERBOARD_RANK_SNAPSHOT_CRON_DISABLED 1
upsert /srv/tuf/config/canary/api.env WEEKLY_CURATION_SCHEDULE_CRON_DISABLED 1
upsert /srv/tuf/config/canary/api.env CORS_EXTRA_ORIGINS http://localhost:18080,http://127.0.0.1:18080
upsert /srv/tuf/config/health.env HEALTH_MAIN_SERVER_URL http://127.0.0.1:3000/v2/health
upsert /srv/tuf/config/health.env HEALTH_CDN_URL http://127.0.0.1:3001/health
upsert /srv/tuf/config/canary/health.env LOG_PATH /tmp/tuf-health-logs
upsert /srv/tuf/config/canary/health.env HEALTH_MAIN_SERVER_URL http://127.0.0.1:13000/v2/health
upsert /srv/tuf/config/canary/health.env HEALTH_CDN_URL http://127.0.0.1:13001/health

/srv/tuf/infra/bin/tuf-config-check
/srv/tuf/infra/bin/tuf-canary-config-check
echo "container runtime paths normalized"
