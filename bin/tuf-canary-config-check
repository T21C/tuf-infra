#!/usr/bin/env bash
set -Eeuo pipefail

readonly production_dir=/srv/tuf/config
readonly canary_dir=/srv/tuf/config/canary
readonly names=(stack common backup redis storage api cdn cdc health thumbnail-worker)

errors=0

fail() {
  echo "error: $*" >&2
  errors=$((errors + 1))
}

value_of() {
  local file=$1 key=$2 line
  line=$(/usr/bin/grep -m1 -E "^${key}=" "$file" || true)
  /usr/bin/printf '%s' "${line#*=}"
}

for name in "${names[@]}"; do
  file="$canary_dir/$name.env"
  [[ -f $file ]] || {
    fail "missing canary config: $file"
    continue
  }
  if /usr/bin/grep -qE '__REQUIRED__|replace-with-git-sha' "$file"; then
    fail "$file still contains placeholders"
  fi
  permissions=$(/usr/bin/stat -c '%a' "$file")
  (( permissions % 10 == 0 )) || fail "$file must not be world-readable"
done

compare_different() {
  local production_file=$1 canary_file=$2 key=$3
  local production_value canary_value
  production_value=$(value_of "$production_file" "$key")
  canary_value=$(value_of "$canary_file" "$key")
  [[ -n $canary_value ]] || {
    fail "$canary_file requires $key"
    return
  }
  [[ $production_value != "$canary_value" ]] || fail "$key must differ between production and canary"
}

compare_different "$production_dir/common.env" "$canary_dir/common.env" DB_DATABASE
compare_different "$production_dir/redis.env" "$canary_dir/redis.env" REDIS_URL
compare_different "$production_dir/storage.env" "$canary_dir/storage.env" CF_BUCKET
compare_different "$production_dir/storage.env" "$canary_dir/storage.env" CF_BACKUP_BUCKET
compare_different "$production_dir/api.env" "$canary_dir/api.env" PROD_PORT
compare_different "$production_dir/cdn.env" "$canary_dir/cdn.env" CDN_PORT
compare_different "$production_dir/cdc.env" "$canary_dir/cdc.env" CDC_HEALTH_PORT
compare_different "$production_dir/health.env" "$canary_dir/health.env" HEALTH_PORT
compare_different "$production_dir/thumbnail-worker.env" "$canary_dir/thumbnail-worker.env" THUMBNAIL_WORKER_PORT
compare_different "$production_dir/thumbnail-worker.env" "$canary_dir/thumbnail-worker.env" THUMBNAIL_QUEUE_NAME
compare_different "$production_dir/thumbnail-worker.env" "$canary_dir/thumbnail-worker.env" THUMBNAIL_QUEUE_PREFIX
compare_different "$production_dir/stack.env" "$canary_dir/stack.env" TUF_COMPOSE_PROJECT_NAME
compare_different "$production_dir/stack.env" "$canary_dir/stack.env" TUF_DATA_ROOT
compare_different "$production_dir/stack.env" "$canary_dir/stack.env" TUF_FRONTEND_HOST_PORT
compare_different "$production_dir/api.env" "$canary_dir/api.env" ELASTICSEARCH_INDEX_PREFIX

require_value() {
  local file=$1 key=$2 expected=$3 actual
  actual=$(value_of "$file" "$key")
  [[ $actual == "$expected" ]] || fail "$key in $file must be $expected"
}

require_value "$canary_dir/common.env" LOG_PATH /srv/tuf/data/logs
require_value "$canary_dir/common.env" CDN_TEMP_ROOT /srv/tuf/data/cdn-temp
require_value "$canary_dir/common.env" WORKSPACE_ROOT /srv/tuf/data/cdn-temp/tuf-workspaces
require_value "$canary_dir/api.env" CACHE_PATH /srv/tuf/data/cache
require_value "$canary_dir/api.env" THUMBNAILS_CACHE_PATH /srv/tuf/data/thumbnails
require_value "$canary_dir/api.env" MYSQL_BACKUP_PATH /srv/tuf/data/backups/mysql
require_value "$canary_dir/api.env" MYSQL_BACKUP_TEMP_PATH /srv/tuf/data/backups/tmp
require_value "$canary_dir/api.env" FILES_BACKUP_PATH /srv/tuf/data/backups/files
require_value "$canary_dir/api.env" ROOT_PATH /app
require_value "$canary_dir/api.env" ELASTICSEARCH_CA_PATH /run/secrets/elasticsearch-ca.crt
require_value "$canary_dir/api.env" ELASTICSEARCH_INDEX_PREFIX tuf_canary_
require_value "$canary_dir/api.env" CORS_EXTRA_ORIGINS http://localhost:18080,http://127.0.0.1:18080
require_value "$canary_dir/storage.env" PACK_CDN_ROOT /srv/tuf/data/cdn-temp/packs
require_value "$canary_dir/health.env" LOG_PATH /tmp/tuf-health-logs
require_value "$canary_dir/health.env" HEALTH_MAIN_SERVER_URL http://127.0.0.1:13000/v2/health
require_value "$canary_dir/health.env" HEALTH_CDN_URL http://127.0.0.1:13001/health
require_value "$canary_dir/thumbnail-worker.env" THUMBNAIL_WORKER_BIND_ADDRESS 127.0.0.1
require_value "$canary_dir/thumbnail-worker.env" THUMBNAIL_WORKER_PORT 13891
require_value "$canary_dir/thumbnail-worker.env" THUMBNAIL_WORKER_CONCURRENCY 1
require_value "$canary_dir/thumbnail-worker.env" THUMBNAIL_JOB_INPUT_PATH /srv/tuf/data/cache/thumbnail-render-inputs
require_value "$canary_dir/thumbnail-worker.env" THUMBNAILS_CACHE_PATH /srv/tuf/data/thumbnails

canary_render_mode=$(value_of "$canary_dir/api.env" THUMBNAIL_RENDER_MODE)
[[ $canary_render_mode == local || $canary_render_mode == queue ]] || \
  fail "THUMBNAIL_RENDER_MODE in canary api.env must be local or queue"
canary_queue_name=$(value_of "$canary_dir/thumbnail-worker.env" THUMBNAIL_QUEUE_NAME)
canary_queue_prefix=$(value_of "$canary_dir/thumbnail-worker.env" THUMBNAIL_QUEUE_PREFIX)
[[ $canary_queue_name =~ ^[A-Za-z0-9_-]+$ ]] || \
  fail "THUMBNAIL_QUEUE_NAME in canary thumbnail-worker.env contains invalid characters"
[[ $canary_queue_prefix =~ ^[A-Za-z0-9_-]+$ ]] || \
  fail "THUMBNAIL_QUEUE_PREFIX in canary thumbnail-worker.env contains invalid characters"
for numeric_key in \
  THUMBNAIL_WORKER_PORT \
  THUMBNAIL_JOB_ATTEMPTS \
  THUMBNAIL_JOB_MAX_HTML_BYTES \
  THUMBNAIL_JOB_MAX_DIMENSION \
  THUMBNAIL_QUEUE_MAX_WAITING \
  THUMBNAIL_REQUEST_WAIT_MS \
  THUMBNAIL_OG_REQUEST_WAIT_MS \
  THUMBNAIL_OUTPUT_POLL_MS; do
  numeric_value=$(value_of "$canary_dir/thumbnail-worker.env" "$numeric_key")
  [[ $numeric_value =~ ^[1-9][0-9]*$ ]] || fail "$numeric_key in canary thumbnail-worker.env must be a positive integer"
done

canary_worker_port=$(value_of "$canary_dir/thumbnail-worker.env" THUMBNAIL_WORKER_PORT)
if [[ $canary_worker_port =~ ^[1-9][0-9]*$ ]] && (( canary_worker_port > 65535 )); then
  fail "THUMBNAIL_WORKER_PORT in canary thumbnail-worker.env must be at most 65535"
fi

for file_and_key in \
  "$canary_dir/api.env:BIND_ADDRESS" \
  "$canary_dir/cdn.env:CDN_BIND_ADDRESS" \
  "$canary_dir/cdc.env:CDC_BIND_ADDRESS" \
  "$canary_dir/health.env:HEALTH_BIND_ADDRESS" \
  "$canary_dir/thumbnail-worker.env:THUMBNAIL_WORKER_BIND_ADDRESS"; do
  file=${file_and_key%%:*}
  key=${file_and_key##*:}
  [[ $(value_of "$file" "$key") == 127.0.0.1 ]] || fail "$key must be 127.0.0.1 in canary"
done

for directory in cache thumbnails logs cdn-temp backups mapping-hashes; do
  [[ -d /srv/tuf-canary/data/$directory ]] || fail "missing /srv/tuf-canary/data/$directory"
done
[[ -f $canary_dir/certs/elasticsearch.crt ]] || fail "missing canary Elasticsearch CA certificate"
[[ -r $canary_dir/secrets/google-application-credentials.json ]] || fail "missing canary Google application credentials"

if (( errors > 0 )); then
  echo "$errors canary configuration error(s) found" >&2
  exit 78
fi

echo "TUF canary configuration is isolated from production"
