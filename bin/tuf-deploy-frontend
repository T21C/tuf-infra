#!/usr/bin/env bash
set -Eeuo pipefail

readonly INFRA_DIR=/srv/tuf/infra
readonly STACK_ENV=/srv/tuf/config/stack.env
readonly LOCK_FILE=/run/lock/tuf-deploy.lock
readonly STACK_UNIT=tuf-stack.service
readonly COMPOSE=(/usr/bin/docker compose --env-file "$STACK_ENV" -f "$INFRA_DIR/compose.yml")

if [[ $# -ne 1 || ! $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{6,127}$ ]]; then
  echo "usage: tuf-deploy-frontend <immutable-image-tag>" >&2
  exit 64
fi

readonly requested_tag=$1
exec 9>"$LOCK_FILE"
/usr/bin/flock -n 9 || {
  echo "another TUF deployment is already running" >&2
  exit 75
}

if ! /usr/bin/systemctl is-enabled --quiet "$STACK_UNIT"; then
  echo "$STACK_UNIT is not enabled; refusing production deployment before explicit cutover" >&2
  exit 78
fi
if ! /usr/bin/systemctl is-active --quiet "$STACK_UNIT"; then
  echo "$STACK_UNIT is not active; refusing production deployment" >&2
  exit 78
fi

previous_tag=$(/usr/bin/awk -F= '$1 == "TUF_FRONTEND_IMAGE_TAG" { print $2; exit }' "$STACK_ENV")
if [[ -z $previous_tag ]]; then
  echo "TUF_FRONTEND_IMAGE_TAG is missing from $STACK_ENV" >&2
  exit 78
fi

set_tag() {
  local tag=$1
  local temporary
  temporary=$(/usr/bin/mktemp "${STACK_ENV}.XXXXXX")
  /usr/bin/awk -F= -v tag="$tag" '
    BEGIN { changed = 0 }
    $1 == "TUF_FRONTEND_IMAGE_TAG" { print "TUF_FRONTEND_IMAGE_TAG=" tag; changed = 1; next }
    { print }
    END { if (!changed) exit 1 }
  ' "$STACK_ENV" >"$temporary"
  /usr/bin/chown --reference="$STACK_ENV" "$temporary"
  /usr/bin/chmod --reference="$STACK_ENV" "$temporary"
  /usr/bin/mv -f "$temporary" "$STACK_ENV"
}

rollback() {
  echo "frontend deployment failed; rolling back to $previous_tag" >&2
  set_tag "$previous_tag"
  if ! "${COMPOSE[@]}" pull frontend; then
    echo "rollback failed while pulling frontend image $previous_tag" >&2
    return 1
  fi
  if ! /usr/bin/systemctl reload "$STACK_UNIT"; then
    echo "rollback failed while reloading $STACK_UNIT with $previous_tag" >&2
    return 1
  fi
  echo "rolled back frontend to $previous_tag" >&2
}

fail_with_rollback() {
  local reason=$1
  echo "$reason" >&2
  if ! rollback; then
    echo "automatic rollback failed; inspect $STACK_UNIT and $STACK_ENV immediately" >&2
  fi
  exit 1
}

set_tag "$requested_tag"
if ! "${COMPOSE[@]}" pull frontend; then
  fail_with_rollback "frontend image pull failed"
fi

if ! /usr/bin/systemctl reload "$STACK_UNIT"; then
  fail_with_rollback "$STACK_UNIT reload failed"
fi

echo "frontend deployed: $requested_tag"
