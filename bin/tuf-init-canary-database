#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "run this command as root" >&2
  exit 77
fi

value_of() {
  local file=$1 key=$2 line
  line=$(/usr/bin/grep -m1 -E "^${key}=" "$file" || true)
  /usr/bin/printf '%s' "${line#*=}"
}

readonly production_dir=/srv/tuf/config
readonly production_common=$production_dir/common.env
readonly canary_common=/srv/tuf/config/canary/common.env
production_database=$(value_of "$production_common" DB_DATABASE)
canary_database=$(value_of "$canary_common" DB_DATABASE)
app_user=$(value_of "$production_common" DB_USER)
cdn_user=$(value_of "$production_dir/cdn.env" DB_USER)
health_user=$(value_of "$production_dir/health.env" DB_USER)
cdc_user=$(value_of "$production_dir/cdc.env" CDC_DB_USER)
readonly production_database canary_database app_user cdn_user health_user cdc_user

for value in "$production_database" "$canary_database" "$app_user" "$cdn_user" "$health_user" "$cdc_user"; do
  [[ $value =~ ^[A-Za-z0-9_]+$ ]] || {
    echo "database names and users must contain only letters, digits, or underscores" >&2
    exit 65
  }
done
[[ $production_database != "$canary_database" ]] || {
  echo "production and canary databases must differ" >&2
  exit 65
}

/usr/bin/mysql --batch --skip-column-names -e \
  "CREATE DATABASE IF NOT EXISTS \`$canary_database\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci"

table_count=$(/usr/bin/mysql --batch --skip-column-names -e \
  "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = '$canary_database'")
if [[ $table_count == 0 ]]; then
  /usr/bin/mysqldump --no-data --routines --triggers --events \
    --single-transaction --set-gtid-purged=OFF "$production_database" \
    | /usr/bin/mysql "$canary_database"
  echo "cloned production schema into $canary_database"
else
  echo "$canary_database already has $table_count table(s); schema clone skipped"
fi

grant_on_canary() {
  local user=$1 privileges=$2 host host_count
  host_count=$(/usr/bin/mysql --batch --skip-column-names -e \
    "SELECT COUNT(*) FROM mysql.user WHERE User = '$user'")
  [[ $host_count != 0 ]] || {
    echo "MySQL account not found for $user" >&2
    exit 66
  }
  while IFS= read -r host; do
    [[ -n $host ]] || continue
    /usr/bin/mysql --batch -e \
      "GRANT $privileges ON \`${canary_database}\`.* TO '${user}'@'${host}'"
  done < <(/usr/bin/mysql --batch --skip-column-names -e \
    "SELECT Host FROM mysql.user WHERE User = '$user'")
}

grant_on_canary "$app_user" "ALL PRIVILEGES"
grant_on_canary "$cdn_user" "SELECT, INSERT, UPDATE, DELETE, EXECUTE, SHOW VIEW, CREATE TEMPORARY TABLES, LOCK TABLES"
grant_on_canary "$health_user" "SELECT, INSERT, UPDATE, DELETE"
grant_on_canary "$cdc_user" "SELECT"

echo "canary database initialized: $canary_database"
